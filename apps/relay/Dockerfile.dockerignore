# The Dockerfile-specific ignore for apps/relay/Dockerfile, which builds
# with the repository root as its context (the app depends on
# crates/quant_relay by path). Same shape as the generated .dockerignore
# beside it, with the paths rebased to the root; Docker reads this one
# because the Dockerfile is not at the context root.
*
!apps/relay
!apps/relay/src
!apps/relay/tests
!apps/relay/relay_db
!apps/relay/relay_db/src
!apps/relay/migrations
!apps/relay/Cargo.toml
!apps/relay/Cargo.lock
!apps/relay/leptoskit.toml
!apps/relay/rust-toolchain.toml
!crates/quant_relay
!crates/quant_relay/src
!crates/quant_relay/Cargo.toml
**/target
*.sqlite3*
.env
.env.*
